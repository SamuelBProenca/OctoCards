# Default GitHub account when the request omits owner.
OWNER=octocat
PORT=3000

# Optional GitHub token. Keep it on the server, never in browser code.
TOKEN=

# Outgoing GitHub request timeout in milliseconds.
GITHUB_TIMEOUT_MS=10000

# false disables the repository playground at /; docs and API stay available.
PLAYGROUND_ENABLED=false

# Per-client API request budget: 12 requests every 60 seconds by default.
API_RATE_LIMIT_MAX=12
API_RATE_LIMIT_WINDOW_MS=60000

# Optional trusted reverse proxy IPs/CIDRs, comma-separated. Keep blank for local/direct access.
TRUSTED_PROXIES=
